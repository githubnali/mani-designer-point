{
  "name": "mani-designer-point",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Mani Designer Point — customised products, corporate gifting, printing and laser engraving.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && vite build --ssr src/entry-server.tsx --outDir .prerender && node scripts/prerender.mjs",
    "build:client": "vite build",
    "preview": "node scripts/serve-dist.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "images": "node scripts/prepare-images.mjs",
    "test:routes": "node scripts/check-routes.mjs",
    "test:responsive": "node scripts/check-responsive.mjs",
    "test:visual": "node scripts/visual-check.mjs"
  },
  "dependencies": {
    "@fontsource-variable/plus-jakarta-sans": "^5.2.8",
    "@fontsource/great-vibes": "^5.2.8",
    "framer-motion": "^14.10.1",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^6.30.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@tailwindcss/vite": "^4.1.12",
    "@types/node": "^22.15.30",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.33.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "puppeteer-core": "^24.16.0",
    "sharp": "^0.34.3",
    "tailwindcss": "^4.1.12",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.39.1",
    "vite": "^7.1.2"
  }
}
